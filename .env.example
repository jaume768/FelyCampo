# Variables para `docker-compose.yml` de la raíz (levanta postgres + redis + backend + frontend).
#
# Este archivo NO sustituye a backend/.env.example: el servicio "backend" del compose
# raíz sigue leyendo backend/.env directamente (así el backend funciona igual standalone,
# como describe backend/README.md). Copia AMBOS antes de arrancar:
#
#   cp .env.example .env
#   cp backend/.env.example backend/.env
#
# Variables OBLIGATORIAS para arrancar (el resto tiene default válido para dev):
#   - Ninguna aquí es estrictamente obligatoria: todas tienen default de desarrollo.
#     Pero backend/.env SÍ la tiene: DJANGO_SECRET_KEY (falla el arranque si falta).

# --- Postgres (servicio "db") ---
# Deben coincidir con el DATABASE_URL de backend/.env (por defecto ya coinciden:
# postgres://felycampo:felycampo@db:5432/felycampo).
POSTGRES_DB=felycampo
POSTGRES_USER=felycampo
POSTGRES_PASSWORD=felycampo

# --- Frontend ---
# URL pública de la API que usará el navegador. El frontend corre en Docker pero el
# navegador del host llama a través del puerto publicado (8001), no por red interna.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Secreto con el que el backend avisa al frontend de que hay contenido publicado
# (POST /api/revalidar). docker-compose.yml se lo pasa a los dos servicios.
REVALIDATE_SECRET=dev-revalidar-cambiame

# Web cerrada al público con el anuncio «estará disponible el…» (true) o abierta
# (false). El equipo entra igual iniciando sesión en http://localhost:3000/acceso.
PRELANZAMIENTO=true
PRELANZAMIENTO_FECHA=2026-11-15
# Firma la cookie de equipo (fc_equipo).
SESION_EQUIPO_SECRET=dev-sesion-equipo-cambiame
