# ============================================================
# Fely Campo — variables de entorno
# Copiar a .env.local (local) o configurarlas en el panel del hosting.
# ============================================================

# ---------- SEO ----------
# Dominio definitivo, sin barra final. Canonical, hreflang, sitemap y
# Open Graph apuntan siempre aquí (también desde staging).
NEXT_PUBLIC_SITE_URL=https://felycampo.com
# "true" SOLO en el despliegue definitivo. Sin ella: noindex en todas las
# páginas y robots.txt bloquea el rastreo (entorno de pruebas).
SITIO_INDEXABLE=

# ---------- Tracking (vacías = no se carga nada) ----------
# Google Tag Manager, ej. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Píxel de Meta, ej. 123456789012345 (solo se carga si la usuaria acepta
# cookies de Marketing)
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Formularios: cita (src/app/api/cita/route.js) y consultas de
# vestidos (src/app/api/consulta-vestido/route.js), ver src/lib/emailFormularios.js ----------
# Clave de Resend (https://resend.com) con el dominio felycampo.com verificado.
RESEND_API_KEY=
# Remitente de los emails.
CITA_EMAIL_REMITENTE=Fely Campo <citas@felycampo.com>
# Email del equipo que recibe el aviso de cada cita y de cada consulta de
# vestido (varios separados por comas). Si falta, se usa info@felycampo.com.
CITA_EMAIL_EQUIPO=info@felycampo.com
