# Variables del despliegue (docker-compose.prod.yml). Copiar a `.env` EN EL SERVIDOR:
#
#   cp .env.prod.example .env
#
# Este archivo NO sustituye a backend/.env.prod: son dos. Este configura Caddy, Postgres
# y el build del frontend; el otro, Django.

# --- Dominio ---
DOMAIN=websjfs.com
# URL pública completa. Se INCRUSTA en el bundle del navegador durante el build del
# frontend: si cambia, hay que reconstruir la imagen (`--build`), no basta reiniciar.
PUBLIC_URL=https://websjfs.com
# Para los avisos de caducidad de Let's Encrypt. Un correo real que se lea.
ACME_EMAIL=cambia@esto.com

# --- Postgres ---
POSTGRES_DB=felycampo
POSTGRES_USER=felycampo
# OBLIGATORIA, sin valor por defecto: genera una larga y única.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Ruta del admin de Django ---
# SIN barras. `/admin` lo ocupa el panel del frontend, así que el admin de Django se mueve
# de sitio. Debe coincidir con DJANGO_ADMIN_URL de backend/.env.prod (allí CON barra
# final). Ponle algo poco adivinable: quita de encima el ruido de los bots.
DJANGO_ADMIN_PATH=panel-django

# --- Publicación de contenido ---
# Con este secreto el backend avisa al frontend de que algo se ha publicado desde el panel
# (POST /api/revalidar, red interna). Compose lo pasa a los DOS servicios: no lo repitas
# en backend/.env.prod.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REVALIDATE_SECRET=

# --- Prelanzamiento y acceso del equipo ---
# true: hasta PRELANZAMIENTO_FECHA el público ve en cualquier URL la pantalla «Muy pronto»
# (cuenta atrás + newsletter; 503 + Retry-After, sin indexar) y el equipo entra iniciando
# sesión en /acceso. A esa hora la web se abre SOLA, sin tocar nada. Para abrirla antes:
# false y `up -d frontend` (sin --build). Fecha ISO con zona, o solo el día (= 12:00).
PRELANZAMIENTO=true
PRELANZAMIENTO_FECHA=2026-11-15T12:00:00+01:00
# Newsletter → Substack. Sin definir: https://felycampo.substack.com. Vacía: no se reenvía.
# SUBSTACK_URL=https://felycampo.substack.com
# Firma la cookie de equipo. Obligatoria. Cambiarla cierra la sesión de todo el equipo.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESION_EQUIPO_SECRET=

# --- Web pública (frontend) ---
# Se INCRUSTAN en el build: cambiarlas exige `--build`.
# Dominio definitivo para canonical, sitemap y Open Graph (también desde pruebas).
SITE_URL=https://felycampo.com
# "true" SOLO cuando DOMAIN sea felycampo.com. En cualquier otro servidor, false: noindex
# en todo y robots.txt cerrado (ver Frontend/docs/PUBLICAR.md).
SITIO_INDEXABLE=false
# El mismo contenedor de Tag Manager que la web de WordPress.
GTM_ID=GTM-T2MJKZHT
# Vacía a propósito: el Pixel va dentro de GTM; rellenarla contaría cada visita dos veces.
META_PIXEL_ID=
