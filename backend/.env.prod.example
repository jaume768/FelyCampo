# Django en producción. Copiar a `backend/.env.prod` EN EL SERVIDOR y rellenar.
#
# `config/settings/production.py` comprueba lo obligatorio AL ARRANCAR y falla con un
# mensaje claro si falta algo, en vez de dejarlo pasar y romperse en caliente.

DJANGO_SETTINGS_MODULE=config.settings.production

# OBLIGATORIA. Genera una nueva, NO reutilices la de desarrollo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
# Obligatorio y sin comodines. El nombre de servicio `backend` hace falta para el
# healthcheck interno y para las llamadas del frontend por la red de Docker.
DJANGO_ALLOWED_HOSTS=websjfs.com,www.websjfs.com,backend,localhost
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json

# Ruta del admin de Django, CON barra final. Debe casar con DJANGO_ADMIN_PATH del .env
# de la raíz (allí sin barras). `/admin` es del panel del frontend.
DJANGO_ADMIN_URL=panel-django/

# --- Base de datos (host `db` = servicio de compose) ---
# La contraseña debe ser LA MISMA que POSTGRES_PASSWORD del .env de la raíz.
DATABASE_URL=postgres://felycampo:CAMBIA_ESTA_CONTRASENA@db:5432/felycampo
DB_CONN_MAX_AGE=60

# --- CORS / CSRF ---
# Todo vive en el mismo dominio, así que basta este origen. NUNCA comodín: con
# credenciales el navegador descarta cualquier respuesta con `Access-Control-Allow-Origin: *`.
CORS_ALLOWED_ORIGINS=https://websjfs.com,https://www.websjfs.com
# Obligatorio: sin él Django responde 403 a TODOS los POST (login, carrito, checkout).
CSRF_TRUSTED_ORIGINS=https://websjfs.com,https://www.websjfs.com

# Mismo dominio para todo → "Lax" basta y evita las restricciones de cookies de terceros
# de Safari. Solo haría falta "None" (y exige HTTPS) si el panel se moviera a un
# subdominio aparte.
COOKIE_SAMESITE=Lax

FRONTEND_BASE_URL=https://websjfs.com
# URL pública de la API, para construir las URLs de las imágenes (apps/core/media_urls.py).
# Mismo dominio: Caddy enruta /api y /media al backend.
BACKEND_PUBLIC_URL=https://websjfs.com

# --- Caché y límites de ritmo ---
# Obligatorio en producción: sin caché compartida los cupos se multiplican por worker.
REDIS_URL=redis://redis:6379/0
# Caddy es el único proxy delante de Django.
NUM_PROXIES=1

# --- Correo ---
# PRUEBAS: con el backend de consola, los correos se escriben en el log del contenedor y
# NO se envían. Así no hace falta SMTP para levantar el sitio.
#   docker compose -f docker-compose.prod.yml logs backend
# Para envíos de verdad: quita esta línea y rellena EMAIL_HOST/USER/PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Obligatorio SIEMPRE, aunque los correos vayan a consola.
DEFAULT_FROM_EMAIL=no-reply@websjfs.com

# --- Reglas de negocio ---
VAT_RATE=0.21
SHIPPING_FLAT_RATE=0.00
ORDER_MINIMUM_TOTAL=0.00
STOCK_RESERVATION_MINUTES=60
RETURN_WINDOW_DAYS=14
INVOICE_REQUEST_EMAIL=facturacion@websjfs.com
PRODUCT_ENQUIRY_EMAIL=info@websjfs.com

# --- Integraciones ---
# Vacías: sin Stripe, el checkout crea el pedido y devuelve `payment: null` (queda
# pendiente de pago). Es a propósito, ver docs/CONTRATO.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
