# --- Django ---
# development | test | production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# json (estructurado) | simple (legible en local)
DJANGO_LOG_FORMAT=json

# --- Base de datos (host "db" = servicio de docker-compose) ---
DATABASE_URL=postgres://felycampo:felycampo@db:5432/felycampo
POSTGRES_DB=felycampo
POSTGRES_USER=felycampo
POSTGRES_PASSWORD=felycampo
DB_CONN_MAX_AGE=60

# --- CORS / CSRF (orígenes del frontend; nunca "*" en producción) ---
# Orígenes del frontend. NUNCA comodín: la sesión va por cookie y con credenciales el
# navegador descarta cualquier respuesta con Access-Control-Allow-Origin: *.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# SameSite de las cookies de sesión y CSRF. Decidido: frontend y API en el mismo dominio
# registrable (felycampo.com + api.felycampo.com), así que "Lax". Solo haría falta "None"
# —y con HTTPS obligatorio— si el frontend se moviera a otro dominio.
COOKIE_SAMESITE=Lax

# --- Debugging dentro de Docker (solo desarrollo) ---
DEBUGPY_ENABLED=true
DEBUGPY_WAIT_FOR_CLIENT=false

# Dominio del FRONTEND: se usa para los enlaces que van dentro de los correos.
FRONTEND_BASE_URL=http://localhost:3000

# --- Correo ---
# En desarrollo va a consola. En producción son OBLIGATORIOS EMAIL_HOST y
# DEFAULT_FROM_EMAIL: production.py falla al arrancar si faltan.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# --- Límites de ritmo (throttling) ---
# Caché compartida entre procesos: sin ella los cupos se multiplican por el número de
# workers. OBLIGATORIA en producción (production.py falla si falta).
REDIS_URL=redis://redis:6379/0
# Proxies de confianza delante de Django (nginx/ALB = 1). Con 0 se usa la IP directa.
# Si se pone mal, el cliente puede falsear X-Forwarded-For y saltarse los límites.
NUM_PROXIES=1
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_ENQUIRY=5/hour
THROTTLE_STOCK_NOTIFICATION=20/hour
THROTTLE_ORDER_LOOKUP=20/hour

# --- Reglas de negocio ---
# Los precios se guardan SIN IVA; este tipo se aplica al calcular.
VAT_RATE=0.21
# PENDIENTE: el cliente debe facilitar la tarifa plana y el importe mínimo de pedido.
SHIPPING_FLAT_RATE=0.00
ORDER_MINIMUM_TOTAL=0.00
STOCK_RESERVATION_MINUTES=60
RETURN_WINDOW_DAYS=14
# PLACEHOLDER: faltan las direcciones reales.
INVOICE_REQUEST_EMAIL=facturacion@example.com
PRODUCT_ENQUIRY_EMAIL=info@example.com

# --- Integraciones ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
CALENDLY_WEBHOOK_SIGNING_KEY=
