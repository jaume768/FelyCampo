# --- Django ---
# development | test | production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# json (estructurado) | simple (legible en local)
DJANGO_LOG_FORMAT=json

# --- Base de datos (host "db" = servicio de docker-compose) ---
DATABASE_URL=postgres://felycampo:felycampo@db:5432/felycampo
POSTGRES_DB=felycampo
POSTGRES_USER=felycampo
POSTGRES_PASSWORD=felycampo
DB_CONN_MAX_AGE=60

# --- CORS / CSRF (orígenes del frontend; nunca "*" en producción) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Debugging dentro de Docker (solo desarrollo) ---
DEBUGPY_ENABLED=true
DEBUGPY_WAIT_FOR_CLIENT=false

# --- Integraciones (Fase 0: vacías, sin lógica) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
CALENDLY_WEBHOOK_SIGNING_KEY=
